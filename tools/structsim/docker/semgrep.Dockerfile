# Разбор исходников в общее синтаксическое дерево, одинаковое для разных
# языков. Версия прибита: формат выгрузки дерева недокументирован и между
# версиями меняется, причём молча.
FROM semgrep/semgrep:1.180.0

# У базового образа ENTRYPOINT = semgrep. Сбрасываем, чтобы можно было
# запускать цикл по файлам одним контейнером: разбор идёт по одному файлу за
# вызов, и контейнер на каждый файл при тысячах файлов стоил бы часы.
# Плата за это — команду приходится называть в явном виде.
ENTRYPOINT []

# Дерево берётся у semgrep-core, а не у публичного CLI: только он умеет
# -full_token_info, то есть отдаёт позиции (line, column, bytepos) каждого
# токена. Без них тайлы нельзя показать строками исходника.
#
# Бинарник лежит внутри питоновского пакета, и в пути зашита версия Python,
# так что прописывать его руками нельзя — сломается при обновлении базового
# образа. Спрашиваем путь у самого пакета и кладём симлинк на PATH.
RUN set -eux; \
    core="$(python3 -c 'import pathlib, semgrep; print(pathlib.Path(semgrep.__file__).parent / "bin" / "semgrep-core")')"; \
    test -x "$core"; \
    ln -s "$core" /usr/local/bin/semgrep-core; \
    semgrep-core -help > /dev/null 2>&1

WORKDIR /work
CMD ["semgrep-core", "-help"]

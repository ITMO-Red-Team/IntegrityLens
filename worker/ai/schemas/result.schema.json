{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["contract", "runId", "methodVersion", "params", "files"],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "integritylens.ai/1"},
    "runId": {"type": "string", "format": "uuid"},
    "methodVersion": {"type": "string", "minLength": 1},
    "params": {"type": "object"},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object", "required": ["submissionId", "status"],
        "additionalProperties": false,
        "properties": {
          "submissionId": {"type": "string", "format": "uuid"},
          "status": {"enum": ["ok", "failed"]},
          "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "suspicious": {"type": "array", "items": {"$ref": "#/$defs/fragment"}},
          "reason": {"$ref": "#/$defs/reason"}
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "ok"}}},
           "then": {"required": ["score", "suspicious"], "properties": {"score": {"type": "number"}}},
           "else": {"required": ["reason"], "properties": {"score": {"type": "null"}, "suspicious": {"maxItems": 0}}}}
        ]
      }
    }
  },
  "$defs": {
    "fragment": {
      "type": "object", "required": ["startIndex", "endIndex", "confidence"], "additionalProperties": false,
      "properties": {
        "startIndex": {"type": "integer", "minimum": 0},
        "endIndex": {"type": "integer", "minimum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "reason": {
      "type": "object", "required": ["code"], "additionalProperties": false,
      "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string"}}
    }
  }
}
